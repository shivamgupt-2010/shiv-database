# SHIV Database V1 Environment Configuration

ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL / SQLite fallback for tests)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/shiv_db

# Security & Authentication
JWT_SECRET_KEY=change-this-in-production-super-secret-key-32bytes-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# External Providers (Optional / Fallback)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_JSON={}

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=10
